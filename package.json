{
  "name": "era",
  "version": "13.1.0",
  "description": "A modern Electron application starter kit with React, Vite, TypeScript, Shadcn UI and TailwindCSS",
  "main": "./out/main/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev -w",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "node scripts/run-tool.mjs test run",
    "test:desktop": "pnpm run vite:build:app && playwright test",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "check": "pnpm run typecheck && pnpm run lint:check && pnpm run format:check && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "vite:build:app": "electron-vite build",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:dir": "electron-builder --dir",
    "build:unpack": "pnpm run vite:build:app && pnpm run electron:build:dir",
    "build:win": "pnpm run vite:build:app && pnpm run electron:build:win",
    "build:mac": "pnpm run vite:build:app && pnpm run electron:build:mac",
    "build:linux": "pnpm run vite:build:app && pnpm run electron:build:linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preinstall": "node scripts/require-pnpm.mjs",
    "postinstall": "install-electron",
    "check:native": "node scripts/check-native.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.108.4",
    "awilix": "^14.0.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "electron-conveyor": "^0.4.1",
    "lucide-react": "^1.79.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^26.13.1",
    "pnpm": "12.23.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
